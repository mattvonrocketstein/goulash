[project]
	description = "Toolbox.  Includes utilities for inspecting and partitioning objects and namespaces, sugar for building call-chains, classproperties, and more."
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/matthew von rocketstein (mattvonrocketstein)
[access "refs/for/refs/*"]
	read = group user/matthew von rocketstein (mattvonrocketstein)
	push = group user/matthew von rocketstein (mattvonrocketstein)
	label-Code-Review = -2..+2 group user/matthew von rocketstein (mattvonrocketstein)
	label-Verified = -1..+1 group user/matthew von rocketstein (mattvonrocketstein)
	rebase = group user/matthew von rocketstein (mattvonrocketstein)
	removeReviewer = group user/matthew von rocketstein (mattvonrocketstein)
	submit = group user/matthew von rocketstein (mattvonrocketstein)
[access "refs/heads/*"]
	read = group user/matthew von rocketstein (mattvonrocketstein)
	create = group user/matthew von rocketstein (mattvonrocketstein)
	push = +force group user/matthew von rocketstein (mattvonrocketstein)
	pushMerge = group user/matthew von rocketstein (mattvonrocketstein)
[access "refs/tags/*"]
	push = +force group user/matthew von rocketstein (mattvonrocketstein)
	pushTag = group user/matthew von rocketstein (mattvonrocketstein)
	pushSignedTag = group user/matthew von rocketstein (mattvonrocketstein)
